# Server Environment Configuration
PORT=5000
NODE_ENV=development

# JWT Secret Key for Authentication Tokens & QR HMAC Signatures
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Database URL / SQLite File Path
DATABASE_URL=dev.db

# Google Gemini AI API Key (Get from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth Credentials (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Nodemailer Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email_here@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=Government Museums & Zoos <noreply@museums.gov.in>
